<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

	<Version>1.0.7</Version>
	<FileVersion>$(Version)</FileVersion>
	<PackageReleaseNotes>
		20261123 Rel 1.0.0 Versione Iniziale
		20261123 Rel 1.0.1 Aggiunta la scelta della cartella DLL nella sezione Solution Migrator in modo tale che il match su Azure  avviene anche con la versione oltre che con il nome del package
		20261124 Rel 1.0.2 Aggiunta la scelta di un prefisso nella sezione Nuget Package Creator per DLL versioni 0.0.0.0 e 1.0.0.0
		20261124 Rel 1.0.3 Aggiunta la cifratura del PAT nel file azuredevops-settings.json
		20261125 Rel 1.0.4 Aggiunti alcuni messaggi di validazione nella sezione Azure DevOps Configuration
		20261125 Rel 1.0.5 Aggiunta una card di evidenziazione del titolo di ciascuna sezione ed una immagine di sfondo nella home
		20261126 Rel 1.0.6 Aggiunte alcune informazioni sulle tabelle dei risultati della sezione Package Upload
		20261126 Rel 1.0.7 Risoluzione Bug: nella sezione Package Matching il match deve avvenire solo se Versione DLL == Versione Package e Nome DLL == Nome Package
	</PackageReleaseNotes>
	  
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.3.0" />
    <PackageReference Include="NuGet.Packaging" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

  <Target Name="ReplaceAzureDevOpsSettingsOnPublish" AfterTargets="Publish">
	<Copy SourceFiles="azuredevops-settings.publish.json" DestinationFiles="$(PublishDir)azuredevops-settings.json" OverwriteReadOnlyFiles="true" />
  </Target>
	
</Project>
