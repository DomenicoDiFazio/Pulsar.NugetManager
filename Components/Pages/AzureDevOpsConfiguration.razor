@page "/azure-devops"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject IAzureDevOpsService AzureDevOpsService

@rendermode InteractiveServer

<PageTitle>Azure DevOps</PageTitle>

<div class="settings-page">

    <div class="page-header">

        <h1>Azure DevOps Configuration</h1>

        <p>
            Configura la connessione ai feed Azure Artifacts.
        </p>

    </div>

    <div class="settings-card">

        <div class="form-group">

            <label>Organization</label>

            <input class="form-input"
                   @bind="Settings.Organization" />

        </div>

        <div class="form-group">
            <label>PAT Token</label>

            <div class="password-container">
                <input type="@(ShowPatToken ? "text" : "password")"
                       class="form-input"
                       @bind="Settings.PersonalAccessToken" />

                <button type="button"
                        class="password-toggle"
                        @onclick="TogglePatVisibility">
                    @(ShowPatToken ? "🙈" : "👁")
                </button>
            </div>
        </div>

        <div class="form-group">

            <label>Default Feed</label>

            <input class="form-input"
                   @bind="Settings.DefaultFeed" />

        </div>

        <div class="actions">

            <button class="save-button"
                    @onclick="SaveAsync">
                Salva
            </button>

            <button class="test-button"
                    disabled="@IsTesting"
                    @onclick="TestConnectionAsync">

                @(IsTesting
                                ? "Test in corso..."
                                : "Testa Connessione")

            </button>

        </div>


        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="message">
                @Message
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(TestMessage))
        {
            <div class="@(ConnectionOk ? "success-box" : "error-box")">
                @TestMessage
            </div>
        }

    </div>

</div>

@code {

    private AzureDevOpsSettings Settings = new();

    private string Message = string.Empty;

    private bool ShowPatToken;

    private bool IsTesting = false;

    private bool ConnectionOk = false;

    private string TestMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Settings = await AzureDevOpsService.GetSettingsAsync();
    }

    private async Task SaveAsync()
    {
        await AzureDevOpsService.SaveSettingsAsync(Settings);

        Message = "Configurazione salvata.";
    }

    private void TogglePatVisibility()
    {
        ShowPatToken = !ShowPatToken;
    }

    private async Task TestConnectionAsync()
    {
        IsTesting = true;

        try
        {
            TestMessage = string.Empty;
            ConnectionOk = false;

            await AzureDevOpsService.SaveSettingsAsync(Settings);

            var feeds =
                await AzureDevOpsService.GetFeedsAsync();

            ConnectionOk = true;

            TestMessage =
                $"Connessione riuscita. Feed trovati: {feeds.Count}";
        }
        catch (Exception ex)
        {
            ConnectionOk = false;

            TestMessage = ex.Message;
        }
        finally
        {
            IsTesting = false;
        }
    }
}
