@page "/azure-devops"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject IAzureDevOpsService AzureDevOpsService

@rendermode InteractiveServer

<PageTitle>Azure DevOps</PageTitle>

<div class="settings-page">

    <div class="page-header">

        <div class="page-icon">
            <img src="images/icon-pubblica.png" alt="" />
        </div>

        <div class="page-header-text">
            <h1>Azure DevOps Configuration</h1>
            <p>
                <b>Configura la connessione ai feed Azure Artifacts.</b>
            </p>
        </div>

    </div>

    <div class="settings-card">

        <div class="form-group">

            <label>Organization</label>

            <input class="form-input"
                   @bind="Settings.Organization" />

        </div>

        <div class="form-group">
            <label>PAT Token</label>

            <div class="password-container">
                <input type="@(ShowPatToken ? "text" : "password")"
                       class="form-input"
                       @bind="Settings.PersonalAccessToken" />

                <button type="button"
                        class="password-toggle"
                        @onclick="TogglePatVisibility">
                    @(ShowPatToken ? "🙈" : "👁")
                </button>
            </div>
        </div>

        <div class="form-group">

            <label>Default Feed (opzionale)</label>

            <input class="form-input"
                   @bind="Settings.DefaultFeed" />

        </div>

        <div class="actions">

            <button class="save-button"
                    @onclick="SaveAsync">
                Salva
            </button>

            <button class="test-button"
                    disabled="@IsTesting"
                    @onclick="TestConnectionAsync">

                @(IsTesting
                                ? "Test in corso..."
                                : "Testa Connessione")

            </button>

            @if (IsTesting)
            {
                <LoadingSpinner Overlay="true" Text="Test in corso..." />
            }
        </div>
    </div>
    <MessageDialog @ref="messageDialog" />
</div>

@code {

    private AzureDevOpsSettings Settings = new();

    private bool ShowPatToken;

    private bool IsTesting = false;

    private MessageDialog messageDialog = default!;

    protected override async Task OnInitializedAsync()
    {
        Settings = await AzureDevOpsService.GetSettingsAsync();
    }

    private async Task SaveAsync()
    {
        if (!ValidateSettings())
        {
            return;
        }

        try
        {
            await AzureDevOpsService.SaveSettingsAsync(Settings);

            messageDialog.Show("Configurazione salvata.", MessageType.Information);
        }
        catch (Exception ex)
        {
            messageDialog.Show(ex.Message, MessageType.Error, "Errore nel salvataggio");
        }
    }


    private void TogglePatVisibility()
    {
        ShowPatToken = !ShowPatToken;
    }

    private async Task TestConnectionAsync()
    {
        if (!ValidateSettings())
        {
            return;
        }

        IsTesting = true;

        try
        {
            await AzureDevOpsService.SaveSettingsAsync(Settings);

            var feeds =
                await AzureDevOpsService.GetFeedsAsync();

            messageDialog.Show(
                $"Connessione riuscita. Feed trovati: {feeds.Count}",
                MessageType.Information,
                "Test connessione");
        }
        catch (Exception ex)
        {
            messageDialog.Show(
                ex.Message,
                MessageType.Error,
                "Test connessione fallito");
        }
        finally
        {
            IsTesting = false;
        }
    }

    private bool ValidateSettings()
    {
        if (string.IsNullOrWhiteSpace(Settings.Organization))
        {
            messageDialog.Show(
                "Inserire il nome dell'Organization Azure DevOps.",
                MessageType.Warning);

            return false;
        }

        if (string.IsNullOrWhiteSpace(Settings.PersonalAccessToken))
        {
            messageDialog.Show(
                "Inserire il Personal Access Token (PAT).",
                MessageType.Warning);

            return false;
        }

        return true;
    }
}
