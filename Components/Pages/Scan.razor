@page "/scan"
@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject IDllScannerService DllScannerService

@rendermode InteractiveServer

<PageTitle>DLL Scanner</PageTitle>

    <div class="scan-page">

    <div class="page-header">

        <div class="page-icon">
            <img src="images/icon-analizza.png" alt="" />
        </div>

        <div class="page-header-text">
            <h1>DLL Scanner</h1>
            <p>
                Analizza una cartella e visualizza le DLL trovate con
                la relativa versione.
            </p>
        </div>

    </div>

        <div class="scan-card">

        <div class="form-group">
            <label>Cartella DLL</label>

            <div class="folder-row">
                <input class="folder-input" @bind="FolderPath" />
                <button class="browse-button" type="button" @onclick="OpenPicker">
                    📂 Sfoglia...
                </button>
            </div>
        <FolderPicker @ref="picker" OnFolderSelected="OnFolderSelected" />
        </div>

         <button class="scan-button"
                    disabled="@IsLoading"
                    @onclick="ScanAsync">
                @(IsLoading
                            ? "Caricamento..."
                            : "Scansiona")
            </button>

        @if (IsLoading)
        {
            <LoadingSpinner Overlay="true"/>
        }
        </div>

        @if (Dlls.Any())
        {
            <div class="result-card">

                <div class="result-header">
                    DLL trovate: <strong>@Dlls.Count</strong>
                </div>

                <div class="table-container">
                    <table class="dll-table">

                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th>Versione</th>
                                <th>Framework</th>
                                <th>Dimensione</th>
                                <th>Percorso</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var dll in Dlls)
                            {
                                <tr>
                                    <td>@dll.Name</td>
                                    <td>@dll.Version</td>
                                    <td class="framework-badge">@dll.TargetFramework</td>
                                    <td class="dll-size">
                                        @FormatFileSize(dll.FileSize)
                                    </td>
                                    <td title="@dll.FullPath">
                                        @dll.FullPath
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>
                </div>
            </div>
        }
        <MessageDialog @ref="messageDialog" />
    </div>


@code {

    private string FolderPath = string.Empty;

    private List<DllInfo> Dlls = [];

    private bool IsLoading = false;

    private bool ScanCompleted = false;
    private FolderPicker picker = default!;

    private void OpenPicker() => picker.Open(FolderPath);

    private void OnFolderSelected(string path) => FolderPath = path;

    private MessageDialog messageDialog = default!;

    private async Task ScanAsync()
    {
        if (string.IsNullOrWhiteSpace(FolderPath) || !Directory.Exists(FolderPath))
        {
            messageDialog.Show(
                "Seleziona una cartella valida.",
                MessageType.Warning);
            return;
        }

        IsLoading = true;
        ScanCompleted = false;
        Dlls.Clear();

        try
        {
            await Task.Delay(1000);

            Dlls = await DllScannerService.ScanFolderAsync(FolderPath);

            ScanCompleted = true;
        }
        catch (Exception ex)
        {
            IsLoading = false;

            messageDialog.Show(ex.Message, MessageType.Error, "Errore durante la scansione");
            return;
        }
        finally
        {
            IsLoading = false;
        }

        if (!Dlls.Any())
        {
            messageDialog.Show(
                "Nessuna DLL trovata nella cartella selezionata.",
                MessageType.Warning);
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };

        double len = bytes;
        int order = 0;

        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }
}