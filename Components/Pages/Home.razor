@page "/"

<PageTitle>Home</PageTitle>

<div class="home-container">

    <div class="hero-card">

        <h1>NuGet Manager</h1>

        <p class="subtitle">
            Strumento per la gestione dei pacchetti NuGet aziendali,
            pubblicazione su Azure DevOps Artifacts e migrazione
            automatica delle solution.
        </p>

    </div>

    <div class="features-container">

        <div class="feature-card">
            <h3>DLL Scanner</h3>

            <p>
                Analizza una cartella e rileva automaticamente
                le DLL e le relative versioni.
            </p>
        </div>

        <div class="feature-card">
            <h3>NuGet Package Creator</h3>

            <p>
                Genera automaticamente i pacchetti NuGet partendo
                dalle librerie trovate.
            </p>
        </div>

        <div class="feature-card">
            <h3>Azure DevOps</h3>

            <p>
                Ricerca, gestione e pubblicazione dei pacchetti
                sui feed Azure Artifacts.
            </p>
        </div>

        <div class="feature-card">
            <h3>Solution Migrator</h3>

            <p>
                Converte automaticamente i riferimenti DLL in
                PackageReference.
            </p>
        </div>

    </div>

</div>
