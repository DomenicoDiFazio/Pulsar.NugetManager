@page "/package-create"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject IDllScannerService DllScannerService
@inject INugetPackageService NugetPackageService

@rendermode InteractiveServer

<PageTitle>Package Creator</PageTitle>

<div class="package-page">

    <div class="page-header">

        <div class="page-icon">
            <img src="images/icon-crea.png" alt="" />
        </div>

        <div class="page-header-text">
            <h1>NuGet Package Creator</h1>
            <p>
                <b>Seleziona una cartella contenente DLL e prepara i pacchetti NuGet da generare.</b>
            </p>
        </div>

    </div>

    <div class="config-card">

        <div class="form-group">
            <label>Cartella DLL</label>

            <div class="folder-row">
                <input class="form-input" @bind="DllFolder" />
                <button class="browse-button" type="button" @onclick="OpenDllPicker">
                    📂 Sfoglia...
                </button>
            </div>

            <button class="action-button load-dll-button"
                    disabled="@IsLoading"
                    @onclick="LoadDllsAsync">
                @(IsLoading
                                ? "Caricamento..."
                                : "Carica DLL")
            </button>

            @if (IsLoading)
            {
                <LoadingSpinner Overlay="true" />
            }
        </div>

        <FolderPicker @ref="picker" OnFolderSelected="OnFolderSelected" />

    </div>

    @if (Dlls.Any())
    {
        <div class="result-card">

            <div class="result-header">
                DLL trovate: <strong>@Dlls.Count</strong>
            </div>

            <table class="dll-table">

                <thead>
                    <tr>
                        <th>
                            <input type="checkbox"
                                   checked="@SelectAll"
                                   @onchange="ToggleSelectAll" />
                        </th>
                        <th>Nome</th>
                        <th>Versione</th>
                        <th>Dimensione</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var dll in Dlls)
                    {
                        <tr>
                            <td>
                                <input type="checkbox" @bind="dll.Selected" />
                            </td>
                            <td>@dll.Name</td>
                            <td>@dll.Version</td>
                            <td>@FormatFileSize(dll.FileSize)</td>
                        </tr>
                    }

            </tbody>

        </table>

    </div>

    <div class="output-card">

        <div class="form-group">
            <label>Cartella Output</label>

            <div class="folder-row">
                <input class="form-input" @bind="OutputFolder" />
                <button class="browse-button" type="button" @onclick="OpenOutputPicker">
                    📂 Sfoglia...
                </button>
            </div>
        </div>

        <div class="form-group">

            <label>Prefisso Package per DLL versione 0.0.0.0 e 1.0.0.0</label>

            <input class="form-input prefix-input"
                   @bind="PackagePrefix" />

        </div>

        <button class="generate-button"
                disabled="@IsGenerating"
                @onclick="GeneratePackagesAsync">
            @(IsGenerating
                        ? "Generazione..."
                        : "Genera Pacchetti")
        </button>

        @if (IsGenerating)
            {
                <LoadingSpinner Overlay="true" Text="Generazione pacchetti in corso..." />
            }

        </div>

        @if (Results.Any())
        {
            <div class="result-card">

                <h4>Risultati</h4>

                <table class="dll-table">

                    <thead>
                        <tr>
                            <th>Pacchetto</th>
                            <th>Esito</th>
                            <th>Percorso</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var result in Results)
                        {
                            <tr>
                                <td>@result.PackageName</td>
                                <td>@(result.Success ? "OK" : "KO")</td>
                                <td>@(result.Success? result.PackagePath: result.ErrorMessage)</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
    }
    <MessageDialog @ref="messageDialog" />
</div>

@code {

    private string DllFolder = string.Empty;

    private string OutputFolder = string.Empty;

    private List<DllInfo> Dlls = [];

    private List<PackageCreationResult> Results = [];

    private bool IsLoading = false;

    private bool IsGenerating = false;

    private bool SelectAll = true;

    private FolderPicker picker = default!;

    private bool isSelectingOutput;

    private MessageDialog messageDialog = default!;

    private string PackagePrefix = string.Empty;

    private async Task LoadDllsAsync()
    {
        if (string.IsNullOrWhiteSpace(DllFolder) || !Directory.Exists(DllFolder))
        {
            messageDialog.Show("Seleziona una cartella DLL valida.", MessageType.Warning);
            return;
        }

        IsLoading = true;
        Dlls.Clear();
        Results.Clear();

        try
        {
            await Task.Delay(1000);

            Dlls = await DllScannerService.ScanFolderAsync(DllFolder);

            foreach (var dll in Dlls)
            {
                dll.Selected = true;

                if (dll.RequiresPrefix)
                {
                    dll.PackagePrefix = PackagePrefix;
                }
            }

            SelectAll = true;
        
        }
        catch (Exception ex)
        {
            IsLoading = false;

            messageDialog.Show(ex.Message, MessageType.Error, "Errore durante il caricamento");
            return;
        }
        finally
        {
            IsLoading = false;
        }

        if (!Dlls.Any())
        {
            messageDialog.Show(
                "Nessuna DLL trovata nella cartella selezionata.",
                MessageType.Warning);
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };

        double len = bytes;

        int order = 0;

        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }

        return $"{len:0.##} {sizes[order]}";
    }

    private async Task GeneratePackagesAsync()
    {
        if (!Dlls.Any(d => d.Selected))
        {
            messageDialog.Show("Seleziona almeno una DLL.", MessageType.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(OutputFolder) || !Directory.Exists(OutputFolder))
        {
            messageDialog.Show("Seleziona una cartella di output valida.", MessageType.Warning);
            return;
        }

        IsGenerating = true;
        Results.Clear();

        try
        {
            Results = await NugetPackageService.CreatePackagesAsync(Dlls, OutputFolder, PackagePrefix);
        }
        catch (Exception ex)
        {
            IsGenerating = false;

            messageDialog.Show(ex.Message, MessageType.Error, "Errore durante la generazione");
            return;
        }
        finally
        {
            IsGenerating = false;
        }

        var failed = Results.Count(r => !r.Success);

        if (failed == 0)
        {
            messageDialog.Show(
                $"Generati correttamente {Results.Count} pacchetti.",
                MessageType.Information,
                "Generazione completata");
        }
        else
        {
            messageDialog.Show(
                $"{Results.Count - failed} pacchetti generati, {failed} falliti. Controlla i dettagli nella tabella dei risultati.",
                MessageType.Warning,
                "Generazione completata con errori");
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        SelectAll = (bool?)e.Value ?? false;

        foreach (var dll in Dlls)
        {
            dll.Selected = SelectAll;
        }
    }

    private void OpenDllPicker()
    {
        isSelectingOutput = false;
        picker.Open(DllFolder);
    }

    private void OpenOutputPicker()
    {
        isSelectingOutput = true;
        picker.Open(OutputFolder);
    }

    private void OnFolderSelected(string path)
    {
        if (isSelectingOutput)
            OutputFolder = path;
        else
            DllFolder = path;
    }
}
