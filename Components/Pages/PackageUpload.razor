@page "/package-upload"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject IAzureDevOpsService AzureDevOpsService

@rendermode InteractiveServer

<PageTitle>Package Upload</PageTitle>

<div class="upload-page">

    <div class="page-header-card">

        <div class="page-header">

            <div class="page-icon">
                <img src="images/icon-pubblica.png" alt="" />
            </div>

            <div class="page-header-text">
                <h1>Package Upload</h1>
                <p>
                    <b>Seleziona una cartella contenente file .nupkg e li pubblica in un feed Azure Artifacts.</b>
                </p>
            </div>

        </div>

    </div>
    <div class="upload-card">

        <div class="form-group">

            <label>Cartella Pacchetti</label>

            <div class="folder-row">
                <input class="form-input"
                       @bind="PackagesFolder" />

                <button class="browse-button"
                        type="button"
                        @onclick="OpenPicker">
                    📂 Sfoglia...
                </button>
            </div>

            <FolderPicker @ref="picker"
                          OnFolderSelected="OnFolderSelected" />

        </div>

        @if (Feeds.Any())
        {
            <div class="form-group">

                <label>Feed Azure Artifacts</label>

                <select class="feed-select"
                        @bind="SelectedFeed">

                    @foreach (var feed in Feeds)
                    {
                        <option value="@feed.Name">
                            @feed.Name
                        </option>
                    }

                </select>

            </div>
        }

        <button class="load-button"
                disabled="@IsLoading"
                @onclick="LoadPackagesAsync">

            @(IsLoading
                        ? "Caricamento..."
                        : "Carica Pacchetti")

        </button>

        @if (IsLoading)
        {
            <LoadingSpinner Overlay="true" />
        }

    </div>

    @if (Packages.Any())
    {
        <div class="result-card">

            <div class="result-header">
                Pacchetti trovati: <strong>@Packages.Count</strong>
            </div>

            <table class="packages-table">

                <thead>
                    <tr>
                        <th>
                            <input type="checkbox"
                                   checked="@SelectAll"
                                   @onchange="ToggleSelectAll" />
                        </th>
                        <th>Pacchetto</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var package in Packages)
                    {
                        <tr>

                            <td>
                                <input type="checkbox"
                                       checked="@package.Selected"
                                       @onchange="e => OnPackageSelectionChanged(package, e)" />
                            </td>

                            <td>
                                @package.FileName
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <div class="actions">

            <button class="publish-button"
                    disabled="@IsPublishing"
                    @onclick="PublishPackagesAsync">

                @(IsPublishing
                                ? "Pubblicazione..."
                                : "Pubblica")

            </button>
            @if (IsPublishing)
                {
                    <LoadingSpinner Overlay="true" Text="Pubblicazione in corso..." />
                }

            </div>

        </div>
    }

    @if (Results.Any())
    {
        <div class="result-card">

            <h3>Risultati Upload</h3>

            <table class="packages-table">

                <thead>
                    <tr>
                        <th>Pacchetto</th>
                        <th>Esito</th>
                        <th>Messaggio</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var result in Results)
                    {
                        <tr>
                            <td>@result.PackageName</td>

                            <td>
                                @(result.Success ? "OK" : "KO")
                            </td>

                            <td>
                                @(result.Success
                                                        ? "Caricato correttamente"
                                                        : result.ErrorMessage)
                    </td>
                </tr>
                                }

                </tbody>

            </table>
        </div>
    }
    @if (IsLoadingFeeds)
    {
        <LoadingSpinner Overlay="true" Text="Caricamento feed in corso..." />
    }

    <MessageDialog @ref="messageDialog" />
</div>

@code {

    private string PackagesFolder = string.Empty;

    private string SelectedFeed = string.Empty;

    private List<AzureFeedInfo> Feeds = [];

    private List<NugetPackageFile> Packages = [];

    private List<PackageCreationResult> Results = [];

    private bool IsLoading = false;

    private bool IsLoadingFeeds = true;

    private bool IsPublishing = false;

    private bool SelectAll = true;

    private FolderPicker picker = default!;

    private MessageDialog messageDialog = default!;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadFeedsAsync();
        }
    }

    private async Task LoadFeedsAsync()
    {
        IsLoadingFeeds = true;
        StateHasChanged();   // mostra subito lo spinner

        string? errorMessage = null;

        try
        {
            Feeds = await AzureDevOpsService.GetFeedsAsync();

            if (Feeds.Any())
            {
                SelectedFeed = Feeds.First().Name;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            IsLoadingFeeds = false;
        }

        StateHasChanged();   // nasconde lo spinner e popola la combo

        if (errorMessage is not null)
        {
            messageDialog.Show(errorMessage, MessageType.Error, "Feed Azure Artifacts");
        }
        else if (!Feeds.Any())
        {
            messageDialog.Show(
                "Nessun Feed Azure Artifacts disponibile.",
                MessageType.Warning,
                "Feed Azure Artifacts");
        }
    }

    private async Task LoadPackagesAsync()
    {
        if (string.IsNullOrWhiteSpace(PackagesFolder) || !Directory.Exists(PackagesFolder))
        {
            messageDialog.Show("Seleziona una cartella valida.", MessageType.Warning);
            return;
        }

        IsLoading = true;
        Packages.Clear();
        Results.Clear();

        try
        {
            await Task.Delay(1000);

            Packages = Directory
                .GetFiles(PackagesFolder, "*.nupkg")
                .Select(x => new NugetPackageFile
                {
                    FileName = Path.GetFileName(x),
                    FullPath = x,
                    Selected = true
                })
                .ToList();

            SelectAll = true;
        }
        catch (Exception ex)
        {
            IsLoading = false;

            messageDialog.Show(ex.Message, MessageType.Error, "Errore durante il caricamento");
            return;
        }
        finally
        {
            IsLoading = false;
        }

        if (!Packages.Any())
        {
            messageDialog.Show(
                "Nessun pacchetto .nupkg trovato nella cartella selezionata.",
                MessageType.Warning);
        }
    }

    private async Task PublishPackagesAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedFeed))
        {
            messageDialog.Show("Seleziona un feed Azure Artifacts.", MessageType.Warning);
            return;
        }

        if (!Packages.Any(p => p.Selected))
        {
            messageDialog.Show("Seleziona almeno un pacchetto.", MessageType.Warning);
            return;
        }

        IsPublishing = true;
        Results.Clear();

        try
        {
            foreach (var package in Packages.Where(x => x.Selected))
            {
                try
                {
                    await AzureDevOpsService.PublishPackageAsync(
                        package.FullPath,
                        SelectedFeed);

                    Results.Add(new PackageCreationResult
                    {
                        PackageName = package.FileName,
                        Success = true
                    });
                }
                catch (Exception ex)
                {
                    Results.Add(new PackageCreationResult
                    {
                        PackageName = package.FileName,
                        Success = false,
                        ErrorMessage = ex.Message
                    });
                }
            }
        }
        finally
        {
            IsPublishing = false;
        }

        var failed = Results.Count(r => !r.Success);

        if (failed == 0)
        {
            messageDialog.Show(
                $"Pubblicati correttamente {Results.Count} pacchetti.",
                MessageType.Information,
                "Pubblicazione completata");
        }
        else
        {
            messageDialog.Show(
                $"{Results.Count - failed} pacchetti pubblicati, {failed} falliti. Controlla i dettagli nella tabella dei risultati.",
                MessageType.Warning,
                "Pubblicazione completata con errori");
        }
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        SelectAll = (bool?)e.Value ?? false;

        foreach (var package in Packages)
        {
            package.Selected = SelectAll;
        }
    }

    private void OnPackageSelectionChanged(NugetPackageFile package, ChangeEventArgs e)
    {
        package.Selected = (bool?)e.Value ?? false;

        SelectAll = Packages.All(x => x.Selected);
    }

    private void OpenPicker() => picker.Open(PackagesFolder);

    private void OnFolderSelected(string path) => PackagesFolder = path;

}
