@page "/migration-engine"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject ISolutionMigrationService SolutionMigrationService
@inject IAzureDevOpsService AzureDevOpsService

@rendermode InteractiveServer

<PageTitle>Migration Engine</PageTitle>

<div class="engine-page">

    <div class="page-header-card">

        <div class="page-header">

            <div class="page-icon">
                <img src="images/icon-migra.png" alt="" />
            </div>

            <div class="page-header-text">
                <h1>Migration Engine</h1>
                <p>
                    <b>Esegue la conversione dei riferimenti DLL in PackageReference e aggiorna i file .csproj.</b>
                </p>
            </div>

        </div>

    </div>

    <div class="config-card">

        <div class="form-group">

            <label>File Solution (.sln)</label>

            <div class="folder-row">
                <input class="form-input" @bind="SolutionFile" />
                <button class="browse-button" type="button" @onclick="OpenFilePicker">
                    📂 Sfoglia...
                </button>
            </div>
            <FilePicker @ref="filePicker" Filter=".sln" OnFileSelected="OnFileSelected" />
        </div>
        <div class="form-group">

            <label>Cartella DLL</label>

            <div class="folder-row">
                <input class="form-input"
                       @bind="DllFolder" />

                <button class="browse-button"
                        type="button"
                        @onclick="OpenFolderPicker">
                    📂 Sfoglia...
                </button>
            </div>

            <FolderPicker @ref="folderPicker"
                          OnFolderSelected="OnFolderSelected" />

        </div>
        <button class="analyze-button"
                disabled="@IsLoading"
                @onclick="AnalyzeAsync">

            @(IsLoading
                        ? "Analisi..."
                        : "Analizza")

        </button>

        @if (IsLoading)
        {
            <LoadingSpinner Overlay="true" Text="Analisi in corso..." />
        }
    </div>
    
    @if (Previews.Any())
    {
        <div class="result-card">

            <table class="result-table data-table">

                <thead>
                    <tr>
                        <th>Solution</th>
                        <th>Progetto</th>
                        <th>Project Path</th>
                        <th>DLL</th>
                        <th>Versione DLL</th>
                        <th>Package</th>
                        <th>Versione Package</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Previews)
                    {
                        <tr>

                            <td>@item.SolutionName</td>

                            <td>@item.ProjectName</td>

                            <td title="@item.ProjectPath">
                                @item.ProjectPath
                            </td>

                            <td>@item.ReferenceName</td>

                            <td>@item.DllVersion</td>

                            <td>@item.PackageName</td>

                            <td>@item.PackageVersion</td>

                        </tr>
                    }

                </tbody>

            </table>
            <div class="action-bar">

                <button class="migrate-button"
                        disabled="@IsMigrating"
                        @onclick="ExecuteMigrationAsync">

                    @(IsMigrating
                                    ? "Migrazione..."
                                    : "Esegui Migrazione")

                </button>
                @if (IsMigrating)
                {
                    <LoadingSpinner Overlay="true" Text="Migrazione in corso..." />
                 }
                </div>
        </div>
    }

    @if (MigrationResults.Any())
    {
        <div class="result-card">

            <h3>Risultati Migrazione</h3>

            <table class="result-table data-table">

                <thead>
                    <tr>
                        <th>Progetto</th>
                        <th>Package</th>
                        <th>Versione</th>
                        <th>Esito</th>
                        <th>Messaggio</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var result in MigrationResults)
                    {
                        <tr>

                            <td>@result.ProjectName</td>

                            <td>@result.PackageName</td>

                            <td>@result.Version</td>

                            <td>
                                @if (result.Success)
                                {
                                    <span class="status-ok">
                                        ✅ Successo
                                    </span>
                                }
                                else
                                {
                                    <span class="status-ko">
                                        ❌ Errore
                                    </span>
                                }
                            </td>

                            <td>@result.Message</td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    <MessageDialog @ref="messageDialog" />
</div>

@code {

    private string SolutionFile = string.Empty;

    private bool IsLoading = false;

    private bool IsMigrating = false;

    private List<ProjectReferenceInfo> References = [];

    private List<PackageMatchInfo> Matches = [];

    private List<MigrationPreviewInfo> Previews = [];

    private List<MigrationResult> MigrationResults = [];

    private FilePicker filePicker = default!;

    private MessageDialog messageDialog = default!;

    private string DllFolder = string.Empty;

    private FolderPicker folderPicker = default!;

    private async Task AnalyzeAsync()
    {
        if (string.IsNullOrWhiteSpace(SolutionFile) || !File.Exists(SolutionFile))
        {
            messageDialog.Show("Seleziona un file solution (.sln) valido.", MessageType.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(DllFolder) || !Directory.Exists(DllFolder))
        {
            messageDialog.Show("Seleziona una cartella DLL valida.", MessageType.Warning);

            return;
        }

        IsLoading = true;
        References.Clear();
        Matches.Clear();
        Previews.Clear();
        MigrationResults.Clear();

        try
        {
            References = await SolutionMigrationService.AnalyzeSolutionAsync(SolutionFile, DllFolder);

            foreach (var reference in References)
            {
                var match = await AzureDevOpsService.FindPackageMatchAsync(reference.ReferenceName, reference.DllVersion);

                Matches.Add(match);
            }

            Previews = await SolutionMigrationService.GeneratePreviewAsync(References, Matches);
        }
        catch (Exception ex)
        {
            IsLoading = false;

            messageDialog.Show(ex.Message, MessageType.Error, "Errore durante l'analisi");
            return;
        }
        finally
        {
            IsLoading = false;
        }

        if (!Previews.Any())
        {
            messageDialog.Show(
                "Nessuna migrazione disponibile per la solution selezionata.",
                MessageType.Warning);
        }
    }

    private async Task ExecuteMigrationAsync()
    {
        if (!Previews.Any())
        {
            messageDialog.Show("Nessuna migrazione da eseguire.", MessageType.Warning);
            return;
        }

        IsMigrating = true;
        MigrationResults.Clear();

        try
        {
            await Task.Delay(1000);

            MigrationResults = await SolutionMigrationService.MigrateAsync(Previews);
        }
        catch (Exception ex)
        {
            IsMigrating = false;

            messageDialog.Show(ex.Message, MessageType.Error, "Errore durante la migrazione");
            return;
        }
        finally
        {
            IsMigrating = false;
        }

        var failed = MigrationResults.Count(r => !r.Success);

        if (failed == 0)
        {
            messageDialog.Show(
                $"Migrazione completata: {MigrationResults.Count} riferimenti convertiti.",
                MessageType.Information,
                "Migrazione completata");
        }
        else
        {
            messageDialog.Show(
                $"{MigrationResults.Count - failed} riferimenti migrati, {failed} falliti. Controlla i dettagli nella tabella dei risultati.",
                MessageType.Warning,
                "Migrazione completata con errori");
        }
    }

    private void OpenFilePicker() => filePicker.Open(SolutionFile);

    private void OnFileSelected(string file) => SolutionFile = file;

    private void OpenFolderPicker() => folderPicker.Open(DllFolder);

    private void OnFolderSelected(string path) => DllFolder = path;

}