@page "/solution-analyzer"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject ISolutionMigrationService SolutionMigrationService

@rendermode InteractiveServer

<PageTitle>Solution Analyzer</PageTitle>

<div class="analyzer-page">

    <div class="page-header">

        <h1>Solution Analyzer</h1>

        <p>
            Analizza una solution Visual Studio e individua
            i riferimenti DLL presenti nei progetti.
        </p>

    </div>

    <div class="config-card">

        <div class="form-group">

            <label>Cartella Solution</label>

            <input class="form-input"
                   @bind="SolutionPath" />

        </div>

        <button class="analyze-button"
                @onclick="AnalyzeAsync">
            Analizza
        </button>

    </div>

    @if (References.Any())
    {
        <div class="result-card">

            <table class="result-table">

                <thead>
                    <tr>
                        <th>Solution</th>
                        <th>Progetto</th>
                        <th>Riferimento</th>
                        <th>HintPath</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var reference in References)
                    {
                        <tr>
                            <td>@reference.SolutionName</td>
                            <td>@reference.ProjectName</td>
                            <td>@reference.ReferenceName</td>
                            <td>@reference.ReferencePath</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

@code {

    private string SolutionPath = string.Empty;
    private string SolutionName = string.Empty;

    private List<ProjectReferenceInfo> References = [];

    private async Task AnalyzeAsync()
    {
        var slnFile = Directory
            .GetFiles(
                SolutionPath,
                "*.sln",
                SearchOption.TopDirectoryOnly)
            .FirstOrDefault();

        SolutionName = slnFile is null
            ? string.Empty
            : Path.GetFileNameWithoutExtension(slnFile);

        References =
            await SolutionMigrationService
                .AnalyzeSolutionAsync(
                    SolutionPath);
    }

}
