@page "/solution-analyzer"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject ISolutionMigrationService SolutionMigrationService

@rendermode InteractiveServer

<PageTitle>Solution Analyzer</PageTitle>

<div class="analyzer-page">

    <div class="page-header">

        <h1>Solution Analyzer</h1>

        <p>
            Analizza una solution Visual Studio e individua
            i riferimenti DLL presenti nei progetti.
        </p>

    </div>

    <div class="config-card">

        <div class="form-group">

            <label>File Solution (.sln)</label>

            <div class="folder-row">
                <input class="form-input" @bind="SolutionFile" />
                <button class="browse-button" type="button" @onclick="OpenFilePicker">
                    📂 Sfoglia...
                </button>
            </div>
            <FilePicker @ref="filePicker" Filter=".sln" OnFileSelected="OnFileSelected" />
        </div>

        <button class="analyze-button"
                disabled="@IsLoading"
                @onclick="AnalyzeAsync">

            @(IsLoading
                        ? "Analisi..."
                        : "Analizza")

        </button>
        @if (IsLoading)
        {
            <LoadingSpinner Overlay="true" Text="Analisi in corso..." />
        }
    </div>
    @if (AnalysisCompleted && !References.Any())
    {
        <div class="warning-message">
            Nessun riferimento DLL trovato nella solution selezionata.
        </div>
    }
    @if (References.Any())
    {
        <div class="result-card">

            <table class="result-table">

                <thead>
                    <tr>
                        <th>Solution</th>
                        <th>Progetto</th>
                        <th>Riferimento</th>
                        <th>HintPath</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var reference in References)
                    {
                        <tr>
                            <td>@reference.SolutionName</td>
                            <td>@reference.ProjectName</td>
                            <td>@reference.ReferenceName</td>
                            <td>@reference.ReferencePath</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>

@code {

    private string SolutionFile = string.Empty;

    private string SolutionName = string.Empty;

    private bool IsLoading = false;

    private bool AnalysisCompleted = false;

    private List<ProjectReferenceInfo> References = [];

    private FilePicker filePicker = default!;

    private async Task AnalyzeAsync()
    {
        IsLoading = true;
        AnalysisCompleted = false;

        try
        {
            References.Clear();

            if (string.IsNullOrEmpty(SolutionFile))
            {
                return;
            }

           
            SolutionName = SolutionFile is null
                ? string.Empty
                : Path.GetFileNameWithoutExtension(SolutionFile);

            References =
                await SolutionMigrationService
                    .AnalyzeSolutionAsync(
                        SolutionFile!);

            AnalysisCompleted = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OpenFilePicker() => filePicker.Open(SolutionFile);

    private void OnFileSelected(string file) => SolutionFile = file;
}
