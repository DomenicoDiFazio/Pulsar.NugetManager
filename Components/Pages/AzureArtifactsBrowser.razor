@page "/azure-artifacts"

@using Pulsar.NugetManager.Models
@using Pulsar.NugetManager.Services.Interfaces

@inject IAzureDevOpsService AzureDevOpsService

@rendermode InteractiveServer

<PageTitle>Azure Artifacts</PageTitle>

<div class="browser-page">

    <div class="page-header">
        <h1>Azure Artifacts Browser</h1>

        <p>
            Visualizza i feed disponibili su Azure DevOps.
        </p>
    </div>

    <button class="load-button"
            disabled="@IsLoading"
            @onclick="LoadFeedsAsync">

        @(IsLoading
                ? "Caricamento..."
                : "Carica Feed")

    </button>
    @if (IsLoading)
    {
        <LoadingSpinner Overlay="true" />
    }
   
    @if (Feeds.Any())
    {
        <div class="result-card">

            <table class="feeds-table">

                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Id</th>
                        <th>Descrizione</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var feed in Feeds)
                    {
                        <tr>
                            <td>@feed.Name</td>
                            <td>@feed.Id</td>
                            <td>@feed.Description</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    <MessageDialog @ref="messageDialog" />
</div>

@code {

    private List<AzureFeedInfo> Feeds = [];

    private bool IsLoading = false;

    private MessageDialog messageDialog = default!;

    private async Task LoadFeedsAsync()
    {
        IsLoading = true;
        Feeds.Clear();

        try
        {
            Feeds = await AzureDevOpsService.GetFeedsAsync();
        }
        catch (Exception ex)
        {
            IsLoading = false;

            messageDialog.Show(ex.Message, MessageType.Error, "Errore nel caricamento dei feed");
            return;
        }
        finally
        {
            IsLoading = false;
        }

        if (!Feeds.Any())
        {
            messageDialog.Show(
                "Nessun feed Azure Artifacts trovato.",
                MessageType.Warning);
        }
    }

}
