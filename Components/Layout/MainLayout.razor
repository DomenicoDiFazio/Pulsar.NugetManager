@inject NavigationManager Navigation
@inherits LayoutComponentBase
@using System.Reflection

<div class="layout-container">

    <aside class="sidebar">

        <div class="application-title">
            Pulsar
            <span>NuGet Manager</span>
        </div>

        <nav class="navigation-menu">

            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
                <img class="nav-icon" src="images/icon-home.svg" alt="" />
                <span>Home</span>
            </NavLink>

            <NavLink href="/scan" class="nav-item">
                <img class="nav-icon" src="images/icon-analizza.png" alt="" />
                <span>DLL Scanner</span>
            </NavLink>

            <NavLink href="/package-create" class="nav-item">
                <img class="nav-icon" src="images/icon-crea.png" alt="" />
                <span>NuGet Package Creator</span>
            </NavLink>

            <button class="menu-group"
                    @onclick="ToggleAzureDevOps">
                @(AzureDevOpsExpanded ? "▼" : "▶")
                Azure DevOps
            </button>

            @if (AzureDevOpsExpanded)
            {
                <div class="submenu">

                    <NavLink href="/azure-devops" class="submenu-item">
                        <img class="submenu-icon" src="images/icon-pubblica.png" alt="" />
                        <span>Azure DevOps Configuration</span>
                    </NavLink>

                    <NavLink href="/azure-artifacts" class="submenu-item">
                        <img class="submenu-icon" src="images/icon-pubblica.png" alt="" />
                        <span>Azure Artifacts Browser</span>
                    </NavLink>

                    <NavLink href="/package-upload" class="submenu-item">
                        <img class="submenu-icon" src="images/icon-pubblica.png" alt="" />
                        <span>Package Upload</span>
                    </NavLink>

                </div>
            }

            <button class="menu-group"
                    @onclick="ToggleSolutionMigrator">
                @(SolutionMigratorExpanded ? "▼" : "▶")
                Solution Migrator
            </button>

            @if (SolutionMigratorExpanded)
            {
                <div class="submenu">

                    <NavLink href="/solution-analyzer" class="submenu-item">
                        <img class="submenu-icon" src="images/icon-migra.png" alt="" />
                        <span>Solution Analyzer</span>
                    </NavLink>

                    <NavLink href="/package-matching" class="submenu-item">
                        <img class="submenu-icon" src="images/icon-migra.png" alt="" />
                        <span>Package Matching</span>
                    </NavLink>

                    <NavLink href="/migration-preview" class="submenu-item">
                        <img class="submenu-icon" src="images/icon-migra.png" alt="" />
                        <span>Migration Preview</span>
                    </NavLink>

                    <NavLink href="/migration-engine" class="submenu-item">
                        <img class="submenu-icon" src="images/icon-migra.png" alt="" />
                        <span>Migration Engine</span>
                    </NavLink>

                </div>
            }

        </nav>

    </aside>

    <div class="content @(IsHomePage ? "content-home" : "content")">
        @Body
    </div>


    <footer class="bottom-bar">
        © @DateTime.Now.Year Pulsar NuGet Manager — Developed by Domenico Di Fazio
        <span class="app-version">v@(AppVersion)</span>
    </footer>

</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {

    private bool AzureDevOpsExpanded = true;

    private bool SolutionMigratorExpanded = true;

    private static readonly string AppVersion = GetAppVersion();

    private void ToggleAzureDevOps()
    {
        AzureDevOpsExpanded = !AzureDevOpsExpanded;
    }

    private void ToggleSolutionMigrator()
    {
        SolutionMigratorExpanded = !SolutionMigratorExpanded;
    }

    private static string GetAppVersion()
    {
        var assembly = typeof(MainLayout).Assembly;

        var version = assembly
            .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion;

        if (string.IsNullOrWhiteSpace(version))
            return assembly.GetName().Version?.ToString(3) ?? "?";

        // Il SDK .NET 8+ aggiunge l'hash del commit (es. 1.0.1+a1b2c3): lo tolgo
        var plus = version.IndexOf('+');
        return plus >= 0 ? version[..plus] : version;
    }

    @inject NavigationManager Navigation

    private bool IsHomePage => string.IsNullOrWhiteSpace(Navigation.ToBaseRelativePath(Navigation.Uri));
}