@inherits LayoutComponentBase
<div class="layout-container">

    <aside class="sidebar">

        <div class="application-title">
            Pulsar
            <span>NuGet Manager</span>
        </div>

        <nav class="navigation-menu">

            <a href="/" class="nav-item">
                Home
            </a>

            <a href="/scan" class="nav-item" >
                DLL Scanner
            </a>

            <a href="/package-create" class="nav-item">
                NuGet Package Creator
            </a>

            <button class="menu-group"
                    @onclick="ToggleAzureDevOps">
                @(AzureDevOpsExpanded ? "▼" : "▶")
                Azure DevOps
            </button>

            @if (AzureDevOpsExpanded)
            {
                <div class="submenu">

                    <a href="/azure-devops" class="submenu-item">
                        Azure DevOps Configuration
                    </a>

                    <a href="/azure-artifacts" class="submenu-item">
                        Azure Artifacts Browser
                    </a>

                    <a href="/package-upload" class="submenu-item">
                        Package Upload
                    </a>

                </div>
            }

            <button class="menu-group"
                    @onclick="ToggleSolutionMigrator">
                @(SolutionMigratorExpanded ? "▼" : "▶")
                Solution Migrator
            </button>

            @if (SolutionMigratorExpanded)
            {
                <div class="submenu">

                    <a href="/solution-analyzer" class="submenu-item">
                        Solution Analyzer
                    </a>

                    <a href="/package-matching" class="submenu-item">
                        Package Matching
                    </a>

                    <a href="/migration-preview" class="submenu-item">
                        Migration Preview
                    </a>

                    <a href="/migration-engine" class="submenu-item">
                        Migration Engine
                    </a>

                </div>
            }

        </nav>

    </aside>

    <main class="content">
        @Body
    </main>

    <footer class="bottom-bar">
        © @DateTime.Now.Year NuGet Manager — Developed by Domenico Di Fazio
    </footer>

</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {

    private bool AzureDevOpsExpanded = true;

    private bool SolutionMigratorExpanded = true;

    private void ToggleAzureDevOps()
    {
        AzureDevOpsExpanded = !AzureDevOpsExpanded;
    }

    private void ToggleSolutionMigrator()
    {
        SolutionMigratorExpanded = !SolutionMigratorExpanded;
    }

}